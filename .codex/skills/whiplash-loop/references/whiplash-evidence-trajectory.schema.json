{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "scope", "git_head", "details"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["git_head_plus_path_manifest_sha256", "path_manifest_sha256", "opaque", "unavailable"]
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "git_head": {"type": ["string", "null"]},
        "details": {"type": "string"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "worker", "round", "task_ref", "candidate_ref",
    "snapshot_before", "snapshot_after", "mutations", "proof", "claims",
    "proof_gaps", "trajectory_status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "worker": {"type": "string", "enum": ["low", "medium", "high"]},
    "round": {"type": "integer", "minimum": 1, "maximum": 5},
    "task_ref": {"type": "string", "minLength": 1},
    "candidate_ref": {"type": "string", "minLength": 1},
    "snapshot_before": {"$ref": "#/$defs/snapshot"},
    "snapshot_after": {"$ref": "#/$defs/snapshot"},
    "mutations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "check", "exit_status", "snapshot_ref", "acceptance_relevant", "result"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["build", "lint", "typecheck", "changed_behavior", "failure_path", "adjacent_no_regression", "manual", "other"]
          },
          "check": {"type": "string", "minLength": 1},
          "exit_status": {
            "oneOf": [
              {"type": "integer"},
              {"type": "string", "enum": ["not_applicable", "unavailable"]}
            ]
          },
          "snapshot_ref": {"type": "string", "minLength": 1},
          "acceptance_relevant": {"type": "boolean"},
          "result": {"type": "string", "minLength": 1},
          "artifact_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "proof_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "trajectory_status": {
      "type": "string",
      "enum": ["complete", "incomplete", "stale", "unavailable"]
    }
  }
}
