{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "retryable",
    "needs_human",
    "continue_loop",
    "loop_exit_reason",
    "recommended_next_action",
    "retry_mode",
    "code_change_required",
    "lead_worker",
    "worker_scorecard",
    "issues",
    "evidence",
    "worker_orders",
    "proof_required",
    "premature_review",
    "round_consumed",
    "recurrence",
    "prevention_note"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["pass", "fail", "premature_review"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "needs_human": {
      "type": "boolean"
    },
    "continue_loop": {
      "type": "boolean"
    },
    "loop_exit_reason": {
      "type": "string"
    },
    "recommended_next_action": {
      "type": "string",
      "enum": ["finish", "retry_worker", "ask_human"]
    },
    "retry_mode": {
      "type": "string",
      "enum": ["none", "collect_missing_workers", "evidence_revalidation", "direct_fix", "structural_change", "reset_approach"],
      "description": "Work mode for the next action. retry_worker is routing only and does not imply a code edit."
    },
    "code_change_required": {
      "type": "boolean",
      "description": "True only when the next worker pass is authorized to edit files for a confirmed implementation defect."
    },
    "lead_worker": {
      "type": "string",
      "enum": ["low", "medium", "high", "all", "none"]
    },
    "worker_scorecard": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker", "assessment"],
        "properties": {
          "worker": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message", "file", "line", "suggested_fix"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "status", "details"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["test", "lint", "typecheck", "build", "manual", "diff", "reasoning"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "not_run", "unclear"]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "worker_orders": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proof_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "premature_review": {
      "type": "boolean",
      "description": "True when the reviewer was invoked before the expected worker set was complete. Premature reviews must not consume the round."
    },
    "round_consumed": {
      "type": "boolean",
      "description": "False when the reviewer response is premature or otherwise invalid for advancing the Whiplash round counter."
    },
    "recurrence": {
      "type": "boolean",
      "description": "True if the same defect class appeared in 2 or more rounds."
    },
    "prevention_note": {
      "type": "string",
      "description": "Systemic guard, rule, or test that would prevent this defect class from recurring. Empty string if recurrence is false."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "retry_mode": {
            "enum": ["none", "collect_missing_workers", "evidence_revalidation"]
          }
        },
        "required": ["retry_mode"]
      },
      "then": {
        "properties": {
          "code_change_required": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retry_mode": {
            "enum": ["direct_fix", "structural_change", "reset_approach"]
          }
        },
        "required": ["retry_mode"]
      },
      "then": {
        "properties": {
          "code_change_required": {
            "const": true
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "premature_review"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "continue_loop": { "const": true },
          "recommended_next_action": { "const": "retry_worker" },
          "retry_mode": { "const": "collect_missing_workers" },
          "code_change_required": { "const": false },
          "lead_worker": { "const": "none" },
          "premature_review": { "const": true },
          "round_consumed": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recommended_next_action": {
            "enum": ["finish", "ask_human"]
          }
        },
        "required": ["recommended_next_action"]
      },
      "then": {
        "properties": {
          "retry_mode": { "const": "none" },
          "code_change_required": { "const": false }
        }
      }
    }
  ]
}
